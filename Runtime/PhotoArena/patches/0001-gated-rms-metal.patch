+// Qwen3.5 per-head gated RMS normalization. Generic subgraph validation also
+// verifies that the eliminated intermediates have no external consumers.
+static bool ggml_metal_fusion_check_norm_gate(
+        const ggml_metal_fusion *, const ggml_tensor * const * nodes,
+        const ggml_cgraph *, const int *, int, ggml_metal_fusion_mode) {
+    const auto * norm = nodes[0];
+    const auto * mul = nodes[1];
+    const auto * glu = nodes[2];
+    const auto * weight = mul->src[1];
+    const auto * gate = glu->src[0];
+    return mul->src[0] == norm && glu->src[1] == mul && gate && weight &&
+        ggml_get_glu_op(glu) == GGML_GLU_OP_SWIGLU &&
+        norm->type == GGML_TYPE_F32 && weight->type == GGML_TYPE_F32 &&
+        mul->type == GGML_TYPE_F32 && gate->type == GGML_TYPE_F32 && glu->type == GGML_TYPE_F32 &&
+        weight->ne[0] == norm->ne[0] && ggml_is_contiguous_rows(weight) &&
+        ggml_is_contiguous_rows(gate) && ggml_are_same_shape(gate, norm) &&
+        ggml_are_same_layout(glu, norm);
+}
